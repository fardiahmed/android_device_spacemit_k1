# sysfs
# eMMC host controllers
genfscon sysfs /devices/platform/soc/ffe07000.mmc                          u:object_r:sysfs_mmc:s0
genfscon sysfs /devices/platform/soc/soc:storage-bus/d4281000.mmc          u:object_r:sysfs_mmc:s0
# GPU (PowerVR BXE — K1-X: cac00000.imggpu in device tree)
genfscon sysfs /devices/platform/gpu                                        u:object_r:sysfs_gpu:s0
genfscon sysfs /devices/platform/soc/cac00000.imggpu                       u:object_r:sysfs_gpu:s0
# Actual path on K1-X: GPU sits under soc:multimedia-bus (matches DT node)
genfscon sysfs /devices/platform/soc/soc:multimedia-bus/cac00000.imggpu    u:object_r:sysfs_gpu:s0
# Fallback for any other GPU sysfs nodes
genfscon sysfs /devices/platform/soc/ffe40000.gpu                          u:object_r:sysfs_gpu:s0
# Display subsystem (HDMI) - accessed by surfaceflinger, gralloc, bootanim for hotplug
genfscon sysfs /devices/platform/c0440000.display-subsystem-hdmi           u:object_r:sysfs_gpu:s0
genfscon sysfs /devices/platform/soc/c0400500.hdmi                         u:object_r:sysfs_gpu:s0
# VPU
genfscon sysfs /devices/platform/soc/ff900000.vpu                          u:object_r:sysfs_vpu:s0
# RTC wakeup
genfscon sysfs /devices/platform/soc/ff800000.bus/ff8000a8.rtc/rtc/rtc1/alarmtimer.0.auto/wakeup/wakeup1  u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/ff800000.bus/ff8000a8.rtc/wakeup/wakeup0                             u:object_r:sysfs_wakeup:s0
# Type-C: /sys/class/typec is labelled by the platform policy (sysfs_typec).

# Header I2C4 sensor modules (hwmon/IIO), read by the sensors HAL
genfscon sysfs /devices/platform/soc/d4012800.i2c u:object_r:sysfs_header_sensors:s0
