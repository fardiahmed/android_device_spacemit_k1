on early-init
    mount debugfs debugfs /sys/kernel/debug mode=0755
    # Boot is CPU-bound: max frequency until boot completes.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance

on property:sys.boot_completed=1
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    # Full console logging again after a SPACEMIT_QUIET_BOOT boot.
    write /proc/sys/kernel/printk "7 4 1 7"
    write /proc/sys/kernel/printk_devkmsg on

on init
    symlink /sdcard /storage/sdcard0

on fs
    mount_all /vendor/etc/fstab.k1 --early

on late-fs
    mount_all /vendor/etc/fstab.k1 --late

# wpa_supplicant config and control sockets.
on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# VPU driver: no modalias for "arm china,linlon-v5", load it explicitly.
on early-boot
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor_dlkm/lib/modules amvx

on boot
    chown system system /sys/class/backlight/backlight/brightness
    chmod 0664 /sys/class/backlight/backlight/brightness

    # Stay-on is managed via SettingsProvider overlay (def_stay_on_while_plugged_in)
