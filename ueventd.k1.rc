modalias_handling enabled

/dev/dri/*                0666   system     graphics
/dev/pvr_sync             0660   system     graphics
/dev/dma_heap/system      0666   system     graphics
/dev/dma_heap/linux,cma   0666   system     graphics
/dev/ttyS*                0660   root       system
# Android has no "i2c" group (ueventd rejected the rule with "invalid gid 'i2c'"); use system.
/dev/i2c-*                0660   root       system

# Storage: for factory reset protection feature
/dev/block/by-name/frp   0660   system     system

# multimedia: codec2 and camera
/dev/video*               0660   media     camera
/dev/media*               0660   media     camera
/dev/v4l-subdev*          0660   media     camera

# HDMI-CEC adapter (cec-gpio on GPIO_88), used by android.hardware.tv.hdmi-service.k1 (system)
/dev/cec*                 0660   system     system

# OP-TEE: tee0 for the KeyMint/Gatekeeper HALs (system), teepriv0 for tee-supplicant (system)
/dev/tee0                 0660   system     system
/dev/teepriv0             0660   system     system
